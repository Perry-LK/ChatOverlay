# Copy this file to .env.local for private build-time overrides.
# .env.local is gitignored, so values here never leave your machine.
#
# Vite-exposed values (must start with VITE_ to reach the browser bundle):
#   VITE_DEFAULT_CHANNEL    Default Twitch channel if no URL param is given.
#   VITE_DEFAULT_THEME      Default theme: comfy | minimalist | none.
#
# Build-only values (consumed by vite.config.ts, not exposed to the browser):
#   BASE_PATH               Vite base path. Use / for custom domains, or
#                           /<repo-name>/ for repo-hosted GitHub Pages.

VITE_DEFAULT_CHANNEL=PerryLK
VITE_DEFAULT_THEME=comfy
# BASE_PATH=/
