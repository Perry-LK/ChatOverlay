/* Copy this file to public/custom.css to override the built-in theme. */

:root {
  --co-font: 'Segoe UI', sans-serif;
  --co-font-size: 22px;
  --co-text: #ffffff;
  --co-text-shadow:
    0 0 2px rgba(0, 0, 0, 0.95),
    0 2px 6px rgba(0, 0, 0, 0.85);
  --co-emote-size: 1.75em;
}

.msg {
  background: rgba(7, 10, 16, 0.45);
  border: 1px solid rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(4px);
}

.username {
  letter-spacing: 0.01em;
}

.status {
  display: none;
}